          "serial_port": "[%key:common::config_flow::data::usb_path%]",
          "serial_port_baud": "Baud rate"
        },
        "data_description": {
          "serial_port": "Serial port to access the P1/P2 bus",
          "serial_port_baud": "Baud rate to open the serial port at"
        }
      }
    }
  },
  "entity": {
